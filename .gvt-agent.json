{
  "project": {
    "name": "c3addon-genvid-epic-online-services",
    "description": "Construct 3 addon exposing Epic Online Services (EOS) to Genvid-built games.",
    "languages": ["typescript", "javascript"]
  },
  "commands": {
    "test": "",
    "lint": "npm run lint",
    "build": "npm run build",
    "validate": "npm run lint && npm run build"
  },
  "repo": {
    "host": "github",
    "default_branch": "main"
  },
  "features": {},
  "paths": {
    "docs/TOC.md": "wiki/index.md",
    "docs/issue-triage.md": "wiki/issue-triage.md"
  },
  "wiki": {
    "wikiDir": "wiki",
    "rawDir": "raw"
  },
  "bugTracker": {
    "kind": "github",
    "actionQuery": "gh issue list --repo GenvidTechnologies/c3addon-genvid-epic-online-services --state open -L 200 --json number,title,labels,body,assignees,author,createdAt,milestone",
    "comparisonQuery": "gh issue list --repo GenvidTechnologies/c3addon-genvid-epic-online-services --state all -L 500 --json number,title,labels,state",
    "readOne": "gh issue view {id} --repo GenvidTechnologies/c3addon-genvid-epic-online-services --json number,title,body,labels,comments",
    "commentsQuery": "gh issue list --repo GenvidTechnologies/c3addon-genvid-epic-online-services --state open -L 200 --json number,comments",
    "structureQuery": "gh issue list --repo GenvidTechnologies/c3addon-genvid-epic-online-services --state open -L 200 --json number,parent,subIssuesSummary",
    "refStateQuery": "gh api repos/{repo}/issues/{id} --jq '{number,state,state_reason,closed_at,pull_request:(.pull_request != null),sub_issues_summary}'",
    "triagedLabel": "triaged",
    "needsInfoLabel": "needs-info"
  }
}
